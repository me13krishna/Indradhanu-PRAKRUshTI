# Nugen Intelligence AI Configuration (Indradhanu Hackathon 2026)
# Get your API key and Model ID from the Nugen dashboard (events@hello.nugen.in)
VITE_NUGEN_API_KEY=your_nugen_api_key_here
VITE_NUGEN_MODEL_ID=prakrushti-eco-v1
VITE_NUGEN_BASE_URL=https://api.nugen.in/v1

# Optional Backend / Serverless Secret (for Vercel Serverless Function)
NUGEN_API_KEY=your_nugen_api_key_here
NUGEN_MODEL_ID=prakrushti-eco-v1

